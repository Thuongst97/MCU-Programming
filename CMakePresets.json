{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "nucleo-base", "hidden": true, "generator": "Ninja",
      "toolchainFile": "${sourceDir}/examples/common/cmake/arm-none-eabi.cmake",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    { "name": "nucleo-debug", "inherits": "nucleo-base", "displayName": "NUCLEO-G474RE (Debug, -Og)", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "nucleo-release", "inherits": "nucleo-base", "displayName": "NUCLEO-G474RE (Release, -Os)", "cacheVariables": { "CMAKE_BUILD_TYPE": "MinSizeRel" } },
    {
      "name": "host-tests", "displayName": "Host unit tests (Unity)", "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-tests", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    }
  ],
  "buildPresets": [
    { "name": "nucleo-debug", "configurePreset": "nucleo-debug" },
    { "name": "nucleo-release", "configurePreset": "nucleo-release" },
    { "name": "host-tests", "configurePreset": "host-tests" }
  ],
  "testPresets": [
    { "name": "host-tests", "configurePreset": "host-tests", "output": { "outputOnFailure": true } }
  ]
}
