# Load the Blue Pill platform and an ELF:   renode -e '$bin=@path/to/app.elf; include @examples/common/renode/bluepill.resc'
$name?="bluepill"
using sysbus
mach create $name
machine LoadPlatformDescription $ORIGIN/bluepill.repl
showAnalyzer sysbus.usart1

macro reset
"""
    sysbus LoadELF $bin
    cpu VectorTableOffset 0x08000000
"""
runMacro $reset
